NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIALS_ENCRYPTION_KEY=
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://chatbase-beryl.vercel.app

# Opcional: seed inicial de una segunda cuenta (no commitear valores reales)
# YCLOUD_ACCOUNT_2_API_KEY=
# YCLOUD_ACCOUNT_2_WEBHOOK_SECRET=

# API Sofia (pausa / reanudación). La misma clave sirve para YCloud 1 y 2.
# YCloud 1: https://sofia-api-ycloud-dev.thankfulsky-d6ee3cbf.eastus.azurecontainerapps.io
# YCloud 2: https://sofia-api-ycloud-global.thankfulsky-d6ee3cbf.eastus.azurecontainerapps.io
SOFIA_API_SECRET_KEY=
# SOFIA_API_BASE_YCLOUD_1=
# SOFIA_API_BASE_YCLOUD_2=

# SmartSales: lista blanca y copia de mensajes de texto escritos a mano.
# El fallo de esta API no bloquea el envío de WhatsApp.
SMARTSALES_API_BASE_URL=https://smartsalesagent-api-prod.azurewebsites.net
SMARTSALES_API_TOKEN=

# Archivos del chat en Azure Blob, en un contenedor privado llamado chat-media.
# Sin esta variable los archivos quedan en Supabase Storage. Usa la identidad administrada de la app.
# AZURE_BLOB_ACCOUNT_URL=https://<cuenta>.blob.core.windows.net

# Tareas periódicas: copia de archivos de YCloud a Blob y limpieza de webhook_events.
# Solo corren con BACKGROUND_JOBS=1 y SQL Server. Nunca lo actives en desarrollo con credenciales reales.
# BACKGROUND_JOBS=1
# Días que se conservan los eventos. Por defecto 30, mínimo 7.
# EVENT_RETENTION_DAYS=30
